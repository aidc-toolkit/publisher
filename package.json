{
  "name": "@aidc-toolkit/publisher",
  "version": "2.0.0-alpha",
  "description": "Publisher for AIDC Toolkit",
  "type": "module",
  "private": true,
  "main": "dist/index.js",
  "homepage": "https://aidc-toolkit.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aidc-toolkit/publisher.git"
  },
  "bugs": {
    "url": "https://github.com/aidc-toolkit/publisher/issues"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "Kevin Dean",
    "email": "Kevin.Dean@datadevelopment.com",
    "url": "https://www.linkedin.com/in/kdean"
  },
  "scripts": {
    "clean-install": "npm clean-install && tsx src/clean-install.ts $*",
    "lint": "eslint",
    "build:alpha": "tsc --project tsconfig-src.json --noEmit && tsc --project tsconfig-config.json --noEmit",
    "publish-alpha": "tsx src/alpha-publisher.ts $*",
    "publish-beta": "tsx src/non-alpha-publisher.ts beta $*",
    "publish-prod": "tsx src/non-alpha-publisher.ts prod $*"
  },
  "devDependencies": {
    "@aidc-toolkit/dev": "^2.0.0-alpha",
    "@octokit/types": "^18.0.0",
    "npm-check-updates": "^23.1.1",
    "octokit": "^5.0.5",
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "@aidc-toolkit/core": "^2.0.0-alpha"
  },
  "allowScripts": {
    "esbuild": true,
    "fsevents": true
  }
}
